{
  "name": "regional-streaming-service",
  "version": "1.0.0",
  "description": "Modern regional video streaming service with AV1 encoding",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/lib/db/migrate.ts",
